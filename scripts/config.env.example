# Copy to scripts/config.env and edit paths for your machine.
#   cp scripts/config.env.example scripts/config.env

# GPU id visible to training / generation
CUDA_ID="${CUDA_ID:-0}"

# Experiment root (checkpoints + generated images)
# EXP_DIR=./outputs/nudity_sage

# SD v1.4 CompVis ckpt (download instruction in models/README.md)
CKPT_PATH=./models/sd-v1-4-full-ema.ckpt
DIFFUSERS_UNET_CONFIG=./models/diffusers_unet_config.json

# HuggingFace model id / local snapshot for inference
export SD_MODEL_ID=CompVis/stable-diffusion-v1-4

# Optional HuggingFace cache
# export HF_HOME=~/.cache/huggingface

# COCO image roots for FID (download separately)
COCO_200_IMGS=./data/imgs/coco_200
COCO_10K_IMGS=./data/imgs/coco_10k

# Style classifier checkpoint directory (for style_eval.py)
STYLE_CLASSIFIER_DIR=./models/style_classifier/checkpoint-2800

# I2P includes Q16 by default. Set RUN_Q16=0 for a NudeNet-only run.
# RUN_Q16=0
# I2P NudeNet uses 0.6 by default. Set I2P_NUDENET_THRESHOLD=0.5 for the original i2P.sh.



# Set target ckpt to the path corresponding to the local method weight. Some methods need to be tested in their corresponding environments. For example:
# TARGET_CKPT=(
# "/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/ESD/ESD-Nudity-Diffusers-UNet-noxattn.pt"
# "/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/UCE/UCE-Nudity-Diffusers-UNet.pt"
# "/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/AdvUnlearn/AdvUnlearn_Nudity_text_encoder_full.pt"
# '/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/SAGE/TextEncoder-text_encoder_full-epoch_999.pt'
# '/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/RECE/RECE-Nudity-Diffusers-UNet.pt'
# "/mnt/Diffusion_Space/.Diffusion_data/.baselines_checkpoints/nudity/RACE/compvis-word_nudity-method_noxattn-sg_3-ng_1-iter_1000-lr_1e-05-adv-pgd-eps-0.1-exp-race_nudity/RACE-Nudity-Diffusers-UNet.pt"
# )